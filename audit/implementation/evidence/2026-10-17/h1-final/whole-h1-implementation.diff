+
+
+def node_identity():
+    from importlib.metadata import version
+    from treeneuron.train import source_hash,lock_hash
+    lock_path=Path(__file__).resolve().parents[3]/'locks/node/environment.json'
+    locked=json.loads(lock_path.read_text())
