+            observed.append(name)
+            return np.zeros(len(X))
+        return predict
+    callbacks={name:callback(name) for name in reversed(ROLES)}
+    protected.open_test(frozen,manifest,run_id='unit-0-rep-0').evaluate(callbacks)
+    assert observed==list(ROLES)
